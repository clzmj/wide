# Distribution template: replace URL and SHA256 after publishing a source release.
# This intentionally is not an installable formula before a real release exists.
class Wide < Formula
  desc "A friendly macOS terminal form for Samsung ultrawide layouts"
  homepage "@REPOSITORY_URL@"
  url "@SOURCE_ARCHIVE_URL@"
  sha256 "@SOURCE_ARCHIVE_SHA256@"
  license "MIT"
  depends_on "rust" => :build
  depends_on :macos
  depends_on arch: :arm64
  def install
    system "cargo", "install", "--locked", "--path", ".", "--root", prefix
    bash_completion.install "completions/wide.bash" => "wide"
    zsh_completion.install "completions/_wide"
    fish_completion.install "completions/wide.fish"
  end
  test do
    assert_match "wide", shell_output("#{bin}/wide --version")
  end
end
